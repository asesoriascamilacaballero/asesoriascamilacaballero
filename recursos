    <style>
        /* ===== PÁGINA DE RECURSOS ===== */
        .recursos-page {
            max-width: 900px;
            margin: 0 auto;
            padding: 100px 40px;
        }

        .recursos-header {
            text-align: center;
            margin-bottom: 80px;
        }

        .recursos-header h1 {
            font-family: var(--font-editorial);
            font-size: 4rem;
            color: var(--color-black);
            margin-bottom: 24px;
            font-weight: 400;
        }

        .recursos-header p {
            font-family: var(--font-body);
            font-size: 1rem;
            color: var(--color-espresso);
            line-height: 1.8;
            max-width: 600px;
            margin: 0 auto;
        }

        /* ===== RECURSO DESTACADO ===== */
        .recurso {
            border-top: 1px solid var(--color-sand);
            padding: 60px 0;
            text-align: center;
        }

        .recurso:last-child {
            border-bottom: 1px solid var(--color-sand);
        }

        .recurso .categoria {
            font-family: var(--font-body);
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: var(--color-taupe);
            margin-bottom: 20px;
            display: block;
        }

        .recurso h2 {
            font-family: var(--font-editorial);
            font-size: 2.5rem;
            color: var(--color-black);
            margin-bottom: 20px;
            font-weight: 400;
        }

        .recurso p {
            font-family: var(--font-body);
            font-size: 0.95rem;
            color: var(--color-espresso);
            line-height: 1.8;
            max-width: 550px;
            margin: 0 auto 32px;
        }

        .recurso .btn-recurso {
            display: inline-block;
            background: var(--color-espresso);
            color: var(--color-white);
            padding: 18px 48px;
            font-family: var(--font-body);
            font-size: 0.75rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            text-decoration: none;
            transition: opacity 0.3s;
        }

        .recurso .btn-recurso:hover {
            opacity: 0.85;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            .recursos-page {
                padding: 60px 20px;
            }

            .recursos-header {
                margin-bottom: 50px;
            }

            .recursos-header h1 {
                font-size: 2.5rem;
            }

            .recursos-header p {
                font-size: 0.95rem;
            }

            .recurso {
                padding: 40px 0;
            }

            .recurso h2 {
                font-size: 1.8rem;
            }

            .recurso .btn-recurso {
                padding: 16px 36px;
            }
        }
    </style>
</head>
